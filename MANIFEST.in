recursive-include evolutionary_prompt_embedding/tensors *.pt
recursive-include evolutionary_prompt_embedding/tensors *.safetensors *.json
recursive-include evolutionary_prompt_embedding/assets *.html
recursive-include docs *.md
recursive-include configs/examples *.json
recursive-include environments *.in *.lock *.txt
include AGENTS.md uv.lock
include notebooks/*.ipynb
recursive-include pre-testing *.ipynb *.md
recursive-include evolutionary_extensions/experiments/detector_evaluation/report_content *.jsx *.css
prune .local
prune .codegraph
prune results
prune experiment_inputs
prune experiment_runs
prune build
prune dist
prune notebooks/results
global-exclude __pycache__ *.py[cod] .DS_Store

# Range helpers accompany their templates; generated/private evidence stays local.
recursive-include pre-testing/clamp_range *.py
prune pre-testing/clamp_range/results
prune docs/research
